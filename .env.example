# Application Settings
APP_NAME=Nakh
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# Redis Configuration (used for data storage and Celery)
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_ENABLED=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=30

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
MEDIA_ROOT=./media

# Token Expiry (seconds) - default 7 days
TOKEN_EXPIRY_SECONDS=604800

# Upload Expiry (seconds) - default 24 hours
UPLOAD_EXPIRY_SECONDS=86400

# Logging
LOG_LEVEL=INFO

# LLM Configuration (Persian Chatbot)
LLM_ENABLED=True
# Model path: HuggingFace model ID or local path
# Examples:
#   - HooshvareLab/gpt2-fa (Persian GPT-2)
#   - m3hrdadfi/gpt2-persian
#   - /path/to/local/model
#   - /path/to/model.gguf (for GGUF models)
LLM_MODEL_PATH=
LLM_MODEL_TYPE=transformers  # "transformers" or "gguf"
LLM_DEVICE=auto  # "auto", "cpu", "cuda", "cuda:0"
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7
LLM_LOAD_IN_8BIT=False  # Enable for lower memory usage
LLM_LOAD_IN_4BIT=False  # Enable for even lower memory (slower)

# External Shop API (Laravel CMS) for product recommendations
# Local dev: http://127.0.0.1:8000   Docker: http://nakh-cms
SHOP_API_URL=
SHOP_API_KEY=

# Mock products: NEVER show fabricated products/prices to real users.
# Keep False in production. Set True only for local dev / tests where no CMS
# is running and you want sample data instead of an "unavailable" state.
ALLOW_MOCK_PRODUCTS=False

# LLM concurrency & prompt caching
LLM_MAX_CONCURRENCY=2          # max simultaneous LLM generations
LLM_KEEP_ALIVE=30m             # keep Ollama model warm (enables prompt cache)

# PARE processing queue
PARE_MAX_WORKERS=1             # GPU-heavy; keep 1 unless multiple GPUs
PARE_MAX_QUEUE_DEPTH=20        # reject new jobs beyond this (503)

# Semantic recommendation re-ranking (optional, via Ollama embeddings)
EMBEDDING_ENABLED=False
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BLEND_WEIGHT=0.4     # final = (1-w)*token + w*semantic

# Observability
METRICS_ENABLED=True
EVENT_LOG_ENABLED=True         # append-only behavioural event log (flywheel)

# Auth proxy: validate Sanctum tokens against the Laravel CMS
ECOMMERCE_AUTH_URL=
ECOMMERCE_API_KEY=

# Meilisearch — attribute-based product search (optional)
# When set, product recommendations use Meilisearch for attribute filtering
# instead of CMS PHP queries (which can hang on attribute filters).
# Local dev: http://localhost:7700   Docker: http://meilisearch:7700
#COMMAND to run
#meilisearch --master-key="your-secret-key-here"
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=E2gJrJlTICK7HDs6N0Q1Mpdx1WvCxkbiskZ9GuAs0WY

# Internal Laravel API — for persisting chat sessions and measurements
# to MySQL via Laravel instead of local JSON files.
# Local dev: http://127.0.0.1:8000   Docker: http://nakh-cms
INTERNAL_API_URL=
INTERNAL_API_KEY=

# FastAPI bind (only used by `python -m app.main`)
SERVER_HOST=0.0.0.0
SERVER_PORT=8002
